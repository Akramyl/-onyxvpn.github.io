<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>OnyxVPN - Fast & Secure VPN</title>
  <style>
    html { scroll-behavior: smooth; }
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --purple: #7c3aed;
      --purple-light: #a855f7;
      --bg: #0d0d1a;
      --bg2: #0a0a18;
      --card: #13132a;
      --border: #2a1a4a;
      --text-muted: #8080a0;
    }

    body {
      background: var(--bg);
      color: #fff;
      font-family: 'Segoe UI', sans-serif;
      overflow-x: hidden;
    }

    /* ─── NAV ─── */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      background: rgba(13,13,26,0.96);
      backdrop-filter: blur(12px);
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      z-index: 100;
      border-bottom: 1px solid var(--border);
      transition: top 0.3s ease;
    }
    .logo { font-size: 1.4rem; font-weight: 900; }
    .logo span { color: var(--purple); }
    .nav-btn {
      background: linear-gradient(135deg, var(--purple), var(--purple-light));
      color: #fff;
      padding: 10px 20px;
      border-radius: 25px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      white-space: nowrap;
      transition: opacity 0.2s, transform 0.2s;
    }
    .nav-btn:hover { opacity: 0.85; transform: scale(1.03); }

    /* ─── HERO ─── */
    .hero {
      text-align: center;
      padding: 130px 20px 60px;
      background: radial-gradient(ellipse at 50% 30%, #1e0845 0%, var(--bg) 65%);
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(124,58,237,0.15), transparent 70%);
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
    .hero img.app-icon {
      width: 100px; height: 100px;
      border-radius: 24px;
      margin-bottom: 20px;
      box-shadow: 0 0 50px rgba(124,58,237,0.6);
    }
    .hero h1 {
      font-size: clamp(2rem, 8vw, 3.2rem);
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 14px;
    }
    .hero h1 span { color: var(--purple-light); }
    .hero p {
      font-size: clamp(0.95rem, 3vw, 1.1rem);
      color: var(--text-muted);
      max-width: 480px;
      margin: 0 auto 32px;
      line-height: 1.75;
    }
    .download-btn {
      display: inline-block;
      background: linear-gradient(135deg, var(--purple), var(--purple-light));
      color: #fff;
      padding: 15px 38px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 0 35px rgba(124,58,237,0.5);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .download-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 55px rgba(168,85,247,0.7);
    }
    .badge {
      display: inline-block;
      background: rgba(124,58,237,0.15);
      border: 1px solid rgba(124,58,237,0.35);
      color: var(--purple-light);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 30px;
      margin-bottom: 18px;
    }

    /* ─── STATS ─── */
    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background: var(--border);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    @media (min-width: 600px) {
      .stats { grid-template-columns: repeat(4, 1fr); }
    }
    .stat {
      text-align: center;
      padding: 28px 16px;
      background: var(--bg);
    }
    .stat h3 {
      font-size: 1.8rem;
      font-weight: 900;
      background: linear-gradient(135deg, var(--purple), var(--purple-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat p { color: var(--text-muted); font-size: 0.82rem; margin-top: 4px; }

    /* ─── SCREENSHOTS ─── */
    .screenshots {
      padding: 70px 20px;
      text-align: center;
      background: var(--bg2);
    }
    .section-title { font-size: clamp(1.6rem, 5vw, 2.1rem); font-weight: 800; margin-bottom: 8px; }
    .section-title span { color: var(--purple-light); }
    .sub { color: var(--text-muted); margin-bottom: 40px; font-size: 0.95rem; }

    .screenshots-grid {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .screenshots-grid::-webkit-scrollbar { display: none; }
    .screenshots-grid img {
      width: 160px;
      min-width: 160px;
      border-radius: 18px;
      border: 2px solid var(--border);
      box-shadow: 0 0 30px rgba(124,58,237,0.2);
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .screenshots-grid img:hover {
      transform: scale(1.06) translateY(-4px);
      box-shadow: 0 12px 40px rgba(124,58,237,0.4);
    }
    @media (min-width: 600px) {
      .screenshots-grid img { width: 200px; min-width: 200px; }
    }

    /* ─── FEATURES ─── */
    .features { padding: 70px 20px; text-align: center; }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      max-width: 860px;
      margin: 0 auto;
    }
    @media (min-width: 700px) {
      .features-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .feature-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px 18px;
      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
      text-align: center;
    }
    .feature-card:hover {
      border-color: var(--purple);
      transform: translateY(-5px);
      box-shadow: 0 10px 35px rgba(124,58,237,0.2);
    }
    .feature-card .icon {
      font-size: 2rem;
      margin-bottom: 12px;
      display: block;
    }
    .feature-card h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 8px; }
    .feature-card p { color: var(--text-muted); font-size: 0.82rem; line-height: 1.6; }

    /* ─── HOW IT WORKS ─── */
    .howto {
      padding: 70px 20px;
      background: var(--bg2);
      text-align: center;
    }
    .steps {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 500px;
      margin: 0 auto;
    }
    @media (min-width: 600px) {
      .steps { flex-direction: row; justify-content: center; gap: 24px; }
    }
    .step {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px 20px;
      text-align: left;
      flex: 1;
    }
    @media (min-width: 600px) {
      .step { flex-direction: column; text-align: center; align-items: center; }
    }
    .step-num {
      min-width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--purple), var(--purple-light));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 1rem;
    }
    .step h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
    .step p { color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; }

    /* ─── PRIVACY ─── */
    .privacy { padding: 70px 20px; text-align: center; }
    .privacy-box {
      max-width: 680px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px 24px;
      text-align: left;
    }
    .section-label {
      color: var(--purple-light);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .privacy-box p {
      color: #c0c0e0;
      line-height: 1.85;
      margin-bottom: 10px;
      font-size: 0.9rem;
    }
    .privacy-box p:last-child { margin-bottom: 0; }
    .divider { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

    /* ─── CTA ─── */
    .cta {
      text-align: center;
      padding: 80px 20px;
      background: radial-gradient(ellipse at center, #1a0a3a 0%, var(--bg) 70%);
      position: relative; overflow: hidden;
    }
    .cta::before {
      content: '';
      position: absolute;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(168,85,247,0.1), transparent 70%);
      bottom: -80px; right: -60px;
      pointer-events: none;
    }
    .cta h2 {
      font-size: clamp(1.7rem, 6vw, 2.4rem);
      font-weight: 900;
      margin-bottom: 12px;
    }
    .cta h2 span { color: var(--purple-light); }
    .cta p { color: var(--text-muted); margin-bottom: 32px; }
    .cta-meta {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .cta-meta span {
      color: var(--text-muted);
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .cta-meta span::before { content: '✓'; color: var(--purple-light); font-weight: 700; }

    /* ─── FOOTER ─── */
    footer {
      text-align: center;
      padding: 24px 20px;
      color: #3a3a5a;
      font-size: 0.82rem;
      border-top: 1px solid #1a1a30;
    }
  </style>
</head>
